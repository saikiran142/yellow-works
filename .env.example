# Public
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=            # digits only with country code, e.g. 91XXXXXXXXXX

# LLM (server-side only). Without a key the site falls back to rule-based replies.
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=                              # a Haiku-class model id
PERSONALISE_DAILY_LLM_CAP=500

# Leads
DATABASE_URL=                           # Postgres (Neon) URL. Empty = local SQLite file at ./data/leads.db
SQLITE_PATH=./data/leads.db
LEAD_WEBHOOK_URL=                       # Slack/Teams/Zapier incoming webhook that accepts {"text": "..."}
NEXT_PUBLIC_CALENDAR_URL=               # optional booking link shown on the confirmation screen

# Admin (/admin). Both required or admin stays off.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=                   # long random string, e.g. openssl rand -hex 32
